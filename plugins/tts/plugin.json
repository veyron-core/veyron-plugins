{
  "plugin_id": "tts",
  "version": "0.2.0",
  "permissions": ["network"],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "tts",
  "events": [],
  "files": ["tts", "plugin.json"],
  "actions": [
    {
      "name": "tts_synthesize",
      "input": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["sherpa", "openai", "elevenlabs"],
            "description": "sherpa = in-process local ONNX; openai/elevenlabs = cloud via network. Required."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "Text to synthesize. Required."
          },
          "voice": {
            "type": "string",
            "description": "Required. sherpa: Kokoro name (af_heart, ...) or sid:N; openai: documented voice id; elevenlabs: your account's voice id."
          },
          "api_key_env": {
            "type": "string",
            "description": "Env var name the tts process reads at call time (never a literal key); must be on TTS_PLUGIN_ALLOWED_KEY_ENVS. Required for cloud providers, ignored for sherpa."
          },
          "format": {
            "type": "string",
            "enum": ["wav", "pcm", "mp3", "ogg"],
            "description": "Per-provider subset: sherpa wav|pcm (default wav); openai mp3|wav|pcm (default mp3); elevenlabs mp3|pcm (default mp3)."
          },
          "speed": {
            "type": "number",
            "minimum": 0.25,
            "maximum": 4.0,
            "default": 1.0
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000,
            "default": 60000
          },
          "base_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional per-provider override (defaults: https://api.openai.com/v1, https://api.elevenlabs.io)."
          },
          "model": {
            "type": "string",
            "description": "Optional per-provider model override (defaults: gpt-4o-mini-tts, eleven_multilingual_v2)."
          }
        },
        "required": ["provider", "text", "voice"],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "format": { "type": "string", "enum": ["wav", "pcm", "mp3"] },
          "sample_rate_hz": { "type": "integer", "description": "0 when the container can't carry it (MP3 from a cloud provider)." },
          "num_channels": { "type": "integer", "description": "0 when the container can't carry it." },
          "duration_seconds": { "type": "number", "description": "0 when the container can't carry it." },
          "audio_base64": { "type": "string", "description": "Base64-encoded audio bytes." }
        },
        "required": ["format", "sample_rate_hz", "num_channels", "duration_seconds", "audio_base64"],
        "additionalProperties": false
      }
    },
    {
      "name": "tts_voices",
      "input": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["sherpa", "openai", "elevenlabs"],
            "description": "elevenlabs is rejected: voices are per-account."
          }
        },
        "required": ["provider"],
        "additionalProperties": false
      },
      "output": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" }
          },
          "required": ["id", "name"],
          "additionalProperties": false
        }
      }
    }
  ],
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "TTS_PLUGIN_ALLOWED_KEY_ENVS": {
        "type": "string",
        "description": "Required for cloud providers, default-deny: comma-separated allowlist of env var names a caller's api_key_env may reference."
      },
      "TTS_PLUGIN_LOCAL_MODEL_DIR": {
        "type": "string",
        "description": "Required for sherpa: directory with the ONNX model files."
      },
      "TTS_PLUGIN_LOCAL_MODEL_TYPE": {
        "type": "string",
        "enum": ["kokoro", "piper"],
        "description": "Required for sherpa."
      },
      "TTS_PLUGIN_LOCAL_NUM_THREADS": {
        "type": "integer",
        "minimum": 1,
        "default": 2
      },
      "TTS_PLUGIN_KOKORO_LEXICON": {
        "type": "string",
        "description": "Optional comma-separated lexicon list; default auto-detects every lexicon-*.txt in the model dir."
      }
    },
    "additionalProperties": true
  }
}

{
  "plugin_id": "ai",
  "version": "0.2.0",
  "permissions": ["network"],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "ai",
  "events": [],
  "files": ["ai", "plugin.json"],
  "actions": [
    {
      "name": "chat_completion",
      "input": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["anthropic", "openai"],
            "description": "Provider adapter. Required."
          },
          "base_url": {
            "type": "string",
            "format": "uri",
            "description": "Required for openai (no safe default across OpenAI/OpenRouter/Ollama/self-hosted). Optional for anthropic, defaults to https://api.anthropic.com."
          },
          "model": {
            "type": "string",
            "description": "Provider model id. Required, non-empty."
          },
          "api_key_env": {
            "type": "string",
            "description": "Name of an env var the ai process reads at call time (never a literal key). Must be on the operator's AI_PLUGIN_ALLOWED_KEY_ENVS allowlist. Required."
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "role": { "type": "string", "enum": ["user", "assistant", "system"] },
                "content": { "type": "string" }
              },
              "required": ["role", "content"],
              "additionalProperties": false
            },
            "description": "Chat messages. Required, non-empty."
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192,
            "default": 1024
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000,
            "default": 30000
          }
        },
        "required": ["provider", "model", "api_key_env", "messages"],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "content": { "type": "string" },
          "stop_reason": { "type": "string" },
          "usage": {
            "type": "object",
            "properties": {
              "input_tokens": { "type": "integer" },
              "output_tokens": { "type": "integer" }
            },
            "additionalProperties": true
          }
        },
        "required": ["content", "stop_reason", "usage"],
        "additionalProperties": false
      }
    }
  ],
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "AI_PLUGIN_ALLOWED_KEY_ENVS": {
        "type": "string",
        "description": "Required, default-deny: comma-separated, exact-match allowlist of every env var name a caller's api_key_env may reference. Without it every chat_completion request is rejected."
      }
    },
    "required": ["AI_PLUGIN_ALLOWED_KEY_ENVS"],
    "additionalProperties": true
  }
}

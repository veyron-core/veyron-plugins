{
  "plugin_id": "media",
  "version": "0.1.0",
  "permissions": [],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "media",
  "events": [],
  "files": ["media", "plugin.json"],
  "actions": [
    {
      "name": "media_play",
      "input": {
        "type": "object",
        "properties": {
          "player": { "type": "string", "description": "MPRIS player name (org.mpris.MediaPlayer2.<name>); omit for the default player." },
          "uri": { "type": "string", "description": "Optional media URI to open before playing." }
        },
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" }
        },
        "required": ["ok"],
        "additionalProperties": false
      }
    },
    {
      "name": "media_pause",
      "input": {
        "type": "object",
        "properties": {
          "player": { "type": "string", "description": "MPRIS player name; omit for the default player." }
        },
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" }
        },
        "required": ["ok"],
        "additionalProperties": false
      }
    },
    {
      "name": "media_play_pause",
      "input": {
        "type": "object",
        "properties": {
          "player": { "type": "string", "description": "MPRIS player name; omit for the default player." }
        },
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "playing": { "type": "boolean", "description": "Playback state after the toggle." }
        },
        "required": ["ok", "playing"],
        "additionalProperties": false
      }
    },
    {
      "name": "media_next",
      "input": {
        "type": "object",
        "properties": {
          "player": { "type": "string", "description": "MPRIS player name; omit for the default player." }
        },
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" }
        },
        "required": ["ok"],
        "additionalProperties": false
      }
    },
    {
      "name": "media_prev",
      "input": {
        "type": "object",
        "properties": {
          "player": { "type": "string", "description": "MPRIS player name; omit for the default player." }
        },
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" }
        },
        "required": ["ok"],
        "additionalProperties": false
      }
    },
    {
      "name": "media_stop",
      "input": {
        "type": "object",
        "properties": {
          "player": { "type": "string", "description": "MPRIS player name; omit for the default player." }
        },
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" }
        },
        "required": ["ok"],
        "additionalProperties": false
      }
    },
    {
      "name": "media_seek",
      "input": {
        "type": "object",
        "properties": {
          "position_ms": { "type": "integer", "minimum": 0, "description": "Absolute seek target in milliseconds from the start of the track." },
          "player": { "type": "string", "description": "MPRIS player name; omit for the default player." }
        },
        "required": ["position_ms"],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "position_ms": { "type": "integer", "description": "Resulting position in milliseconds." }
        },
        "required": ["position_ms"],
        "additionalProperties": false
      }
    },
    {
      "name": "media_volume",
      "input": {
        "type": "object",
        "properties": {
          "level": {
            "description": "Target volume: a 0.0..1.0 fraction or a 0..100 integer percentage.",
            "type": ["number", "integer"],
            "minimum": 0,
            "maximum": 100
          },
          "player": { "type": "string", "description": "MPRIS player name; omit for the default player." }
        },
        "required": ["level"],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "volume": { "type": "number", "description": "Resulting volume as a 0.0..1.0 fraction." }
        },
        "required": ["volume"],
        "additionalProperties": false
      }
    },
    {
      "name": "media_status",
      "input": {
        "type": "object",
        "properties": {
          "player": { "type": "string", "description": "MPRIS player name; omit for the default player." }
        },
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "player": { "type": "string", "description": "MPRIS player name queried." },
          "status": { "type": "string", "enum": ["Playing", "Paused", "Stopped"] },
          "metadata": {
            "type": "object",
            "description": "Normalized MPRIS metadata (title, artists, album, length_micros, track_id, art_url).",
            "additionalProperties": true
          },
          "volume": { "type": "number", "description": "Volume as a 0.0..1.0 fraction." },
          "position_ms": { "type": "integer", "description": "Current playback position in milliseconds." }
        },
        "required": ["player", "status", "metadata", "volume", "position_ms"],
        "additionalProperties": false
      }
    },
    {
      "name": "media_list_players",
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "object",
        "properties": {
          "players": {
            "type": "array",
            "items": { "type": "string" },
            "description": "MPRIS player names (org.mpris.MediaPlayer2.<name>) available on the session bus."
          }
        },
        "required": ["players"],
        "additionalProperties": false
      }
    }
  ],
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "MEDIA_PLUGIN_PLAYERS": {
        "type": "string",
        "description": "Allowlist mode (default allow-all): comma-separated MPRIS player names (org.mpris.MediaPlayer2.<name>) this plugin may control."
      },
      "MEDIA_PLUGIN_DEFAULT_PLAYER": {
        "type": "string",
        "description": "MPRIS player name used when a request omits `player`. Unset = first available player."
      }
    },
    "additionalProperties": true
  }
}
